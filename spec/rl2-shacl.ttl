@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rl2:  <https://w3id.org/rl2#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

############################################################
# RL2 0.7 SHACL Shapes
# Syntax validation for RL2 policies
############################################################
# The shapes are non-closed so profiles may add domain terms. Core properties nevertheless have
# one canonical structure. Agent, Action, Asset, and profile LeftOperand vocabularies remain open.
############################################################

# Policy shape - validates policy structure
rl2:PolicyShape a sh:NodeShape ;
    sh:targetClass rl2:Policy ;
    sh:property [
        sh:path rl2:clause ;
        sh:minCount 1 ;
        sh:class rl2:Clause ;
        sh:message "A policy must have at least one clause (a Norm, or a Promise in an Offer)."
    ] ;
    sh:property [
        sh:path rl2:grantor ;
        sh:maxCount 1 ;
        sh:class rl2:Agent
    ] ;
    sh:property [
        sh:path rl2:grantee ;
        sh:maxCount 1 ;
        sh:class rl2:Agent
    ] ;
    sh:property [
        sh:path rl2:condition ;
        sh:maxCount 1 ;
        sh:class rl2:Condition ;
        sh:message "A policy may have at most one activation condition."
    ] ;
    sh:property [
        sh:path rl2:prerequisiteDuty ;
        sh:class rl2:Duty ;
        sh:message "Each prerequisiteDuty of a Policy must be a Duty."
    ] .

rl2:PolicyKindShape a sh:NodeShape ;
    sh:targetClass rl2:Policy ;
    sh:xone (
        [ sh:class rl2:Set ]
        [ sh:class rl2:Offer ]
        [ sh:class rl2:Agreement ]
    ) ;
    sh:message "A Policy must have exactly one concrete kind: Set, Offer, or Agreement." .

rl2:ClauseKindShape a sh:NodeShape ;
    sh:targetClass rl2:Clause ;
    sh:xone (
        [ sh:class rl2:Norm ]
        [ sh:class rl2:Promise ]
    ) ;
    sh:message "A Clause must be exactly one of Norm or Promise." .

rl2:NormKindShape a sh:NodeShape ;
    sh:targetClass rl2:Norm ;
    sh:xone (
        [ sh:class rl2:Privilege ]
        [ sh:class rl2:Duty ]
        [ sh:class rl2:Prohibition ]
    ) ;
    sh:message "A Norm must have exactly one concrete kind: Privilege, Duty, or Prohibition." .

# Agreement requires both grantor and grantee, and contains only Norms.
# Promises live in Offers and crystallize on acceptance into Duties.
rl2:AgreementShape a sh:NodeShape ;
    sh:targetClass rl2:Agreement ;
    sh:property [
        sh:path rl2:grantor ;
        sh:minCount 1 ;
        sh:message "An Agreement must identify a grantor."
    ] ;
    sh:property [
        sh:path rl2:grantee ;
        sh:minCount 1 ;
        sh:message "An Agreement must identify a grantee."
    ] ;
    sh:property [
        sh:path rl2:clause ;
        sh:not [ sh:class rl2:Promise ] ;
        sh:message "An Agreement clause must be a Norm, not a Promise. Promises crystallize during pure Offer acceptance."
    ] .

# A Set contains only Norms. Only an Offer permits a Promise clause.
rl2:SetShape a sh:NodeShape ;
    sh:targetClass rl2:Set ;
    sh:property [ sh:path rl2:grantor ; sh:maxCount 0 ;
        sh:message "A Set does not carry Agreement or Offer parties." ] ;
    sh:property [ sh:path rl2:grantee ; sh:maxCount 0 ;
        sh:message "A Set does not carry Agreement or Offer parties." ] ;
    sh:property [
        sh:path rl2:clause ;
        sh:not [ sh:class rl2:Promise ] ;
        sh:message "A Set clause must be a Norm, not a Promise."
    ] .

# Privilege shape
rl2:PrivilegeShape a sh:NodeShape ;
    sh:targetClass rl2:Privilege ;
    sh:property [ sh:path rl2:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Agent ] ;
    sh:property [ sh:path rl2:action ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Action ] ;
    sh:property [ sh:path rl2:object ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rl2:condition ; sh:maxCount 1 ; sh:class rl2:Condition ] ;
    sh:property [ sh:path rl2:counterparty ; sh:maxCount 0 ;
        sh:message "counterparty is defined only for Duties." ] ;
    sh:property [ sh:path rl2:prerequisiteDuty ; sh:class rl2:Duty ;
        sh:message "Each prerequisiteDuty of a Privilege must be a Duty." ] ;
    sh:property [ sh:path rl2:consequentDuty ; sh:class rl2:Duty ;
        sh:message "Each consequentDuty of a Privilege must be a Duty." ] .

# A prerequisite Duty is referenced by one or more Privileges, or by a Policy directly (gating
# every Privilege clause of that Policy). Its policy provenance is derived through those owners.
# A Duty may simultaneously be an independent rl2:clause of a Policy: it then keeps its own
# clause-derived obligation atom, and the prerequisiteDuty reference additionally gates its
# owner(s) — one derived status, reported once (see RL2_Semantics.md). Unattached Duty nodes
# remain valid fragments; when used by Eval they enter a Policy directly through rl2:clause and
# are independent obligations.
rl2:PrerequisiteDutyShape a sh:NodeShape ;
    sh:targetObjectsOf rl2:prerequisiteDuty ;
    sh:class rl2:Duty ;
    sh:property [
        sh:path [ sh:inversePath rl2:prerequisiteDuty ] ;
        sh:minCount 1 ;
        sh:or ( [ sh:class rl2:Privilege ] [ sh:class rl2:Policy ] ) ;
        sh:message "A prerequisite Duty must be referenced only by Privileges or Policies."
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Every Privilege that references a prerequisite Duty must be a clause of a Policy." ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT $this WHERE {
                ?referencer rl2:prerequisiteDuty $this .
                FILTER NOT EXISTS { ?referencer a rl2:Policy . }
                FILTER NOT EXISTS { ?policy rl2:clause ?referencer . }
            }
        """
    ] .

# A consequent Duty is referenced by a Privilege via rl2:consequentDuty; unlike a
# prerequisite Duty it does not gate a decision, so no inverse-reference or Policy-clause
# SPARQL check is required here — only the structural shape of the reference. Sentinel
# placement and obligationStateOperand targeting are compile-owned (RL2_Compilation.md),
# not SHACL-owned.
rl2:ConsequentDutyShape a sh:NodeShape ;
    sh:targetObjectsOf rl2:consequentDuty ;
    sh:nodeKind sh:IRI ;
    sh:class rl2:Duty .

# Duty shape
rl2:DutyShape a sh:NodeShape ;
    sh:targetClass rl2:Duty ;
    sh:property [ sh:path rl2:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Agent ] ;
    sh:property [ sh:path rl2:object ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rl2:counterparty ; sh:maxCount 1 ; sh:class rl2:Agent ] ;
    sh:property [ sh:path rl2:condition ; sh:maxCount 1 ; sh:class rl2:Condition ;
        sh:message "A Duty may have at most one applicability condition." ] ;
    sh:property [ sh:path rl2:dutyWindow ; sh:maxCount 1 ; sh:class rl2:DutyWindow ;
        sh:message "A Duty may have at most one DutyWindow." ] ;
    sh:xone (
        [
            sh:property [ sh:path rl2:action ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Action ] ;
            sh:property [ sh:path rl2:postCondition ; sh:maxCount 1 ; sh:class rl2:Condition ] ;
            sh:property [ sh:path rl2:invariant ; sh:maxCount 0 ]
        ]
        [
            sh:property [ sh:path rl2:invariant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Condition ] ;
            sh:property [ sh:path rl2:action ; sh:maxCount 0 ] ;
            sh:property [ sh:path rl2:postCondition ; sh:maxCount 0 ]
        ]
    ) ;
    sh:message "A Duty must have exactly one canonical form: Achievement (action, optional postCondition) or Maintenance (invariant, no action or postCondition)." .

rl2:DutyWindowShape a sh:NodeShape ;
    sh:targetClass rl2:DutyWindow ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A DutyWindow with both endpoints Absolute must satisfy startInclusive < endExclusive. (Relative endpoints resolve at evaluation time and are not statically orderable.)" ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT $this WHERE {
                $this rl2:startInclusive ?start ;
                      rl2:endExclusive ?end .
                FILTER(?start >= ?end)
            }
        """
    ] .

# Each endpoint of a DutyWindow (P12) is independently Absolute (a literal instant) or Relative
# (an anchor LeftOperand + a duration offset). Split into two shapes, one per endpoint, so each
# gets its own violation message.
rl2:DutyWindowStartEndpointShape a sh:NodeShape ;
    sh:targetClass rl2:DutyWindow ;
    sh:xone (
        [
            sh:property [ sh:path rl2:startInclusive ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:dateTimeStamp ] ;
            sh:property [ sh:path rl2:startRelativeTo ; sh:maxCount 0 ] ;
            sh:property [ sh:path rl2:startOffset ; sh:maxCount 0 ]
        ]
        [
            sh:property [ sh:path rl2:startRelativeTo ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class rl2:LeftOperand ] ;
            sh:property [ sh:path rl2:startOffset ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:dayTimeDuration ] ;
            sh:property [ sh:path rl2:startInclusive ; sh:maxCount 0 ]
        ]
    ) ;
    sh:message "A DutyWindow start endpoint must be exactly one of Absolute (startInclusive alone) or Relative (startRelativeTo paired with startOffset, and vice versa)." .

rl2:DutyWindowEndEndpointShape a sh:NodeShape ;
    sh:targetClass rl2:DutyWindow ;
    sh:xone (
        [
            sh:property [ sh:path rl2:endExclusive ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:dateTimeStamp ] ;
            sh:property [ sh:path rl2:endRelativeTo ; sh:maxCount 0 ] ;
            sh:property [ sh:path rl2:endOffset ; sh:maxCount 0 ]
        ]
        [
            sh:property [ sh:path rl2:endRelativeTo ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:class rl2:LeftOperand ] ;
            sh:property [ sh:path rl2:endOffset ; sh:minCount 1 ; sh:maxCount 1 ;
                sh:datatype xsd:dayTimeDuration ] ;
            sh:property [ sh:path rl2:endExclusive ; sh:maxCount 0 ]
        ]
    ) ;
    sh:message "A DutyWindow end endpoint must be exactly one of Absolute (endExclusive alone) or Relative (endRelativeTo paired with endOffset, and vice versa)." .

# Prohibition shape
rl2:ProhibitionShape a sh:NodeShape ;
    sh:targetClass rl2:Prohibition ;
    sh:property [ sh:path rl2:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Agent ] ;
    sh:property [ sh:path rl2:action ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Action ] ;
    sh:property [ sh:path rl2:counterparty ; sh:maxCount 0 ;
        sh:message "counterparty is defined only for Duties." ] ;
    sh:property [ sh:path rl2:condition ; sh:maxCount 1 ; sh:class rl2:Condition ] ;
    sh:property [ sh:path rl2:object ; sh:minCount 1 ; sh:maxCount 1 ] .

# Promise shape: a Promise is structurally a proposed Duty, with counterparty required
# (unlike on a Duty) and object optional pending Acceptance binding.
rl2:PromiseShape a sh:NodeShape ;
    sh:targetClass rl2:Promise ;
    sh:property [ sh:path rl2:subject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Agent ] ;
    sh:property [ sh:path rl2:counterparty ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Agent ] ;
    sh:property [ sh:path rl2:object ; sh:maxCount 1 ] ;
    sh:property [ sh:path rl2:condition ; sh:maxCount 1 ; sh:class rl2:Condition ] ;
    sh:property [ sh:path rl2:dutyWindow ; sh:maxCount 1 ; sh:class rl2:DutyWindow ] ;
    sh:xone (
        [
            sh:property [ sh:path rl2:action ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Action ] ;
            sh:property [ sh:path rl2:invariant ; sh:maxCount 0 ] ;
            sh:property [ sh:path rl2:postCondition ; sh:maxCount 1 ; sh:class rl2:Condition ;
                sh:message "An action-form Promise may carry at most one proposed post-state check." ]
        ]
        [
            sh:property [ sh:path rl2:invariant ; sh:minCount 1 ; sh:maxCount 1 ; sh:class rl2:Condition ] ;
            sh:property [ sh:path rl2:action ; sh:maxCount 0 ] ;
            sh:property [ sh:path rl2:postCondition ; sh:maxCount 0 ;
                sh:message "A state-form Promise cannot carry a postCondition." ]
        ]
    ) ;
    sh:message "A Promise carries subject (promisor), counterparty (promisee), and exactly one of action or invariant." .

############################################################
# Condition Shapes
############################################################

# Atomic constraints are simple comparisons (leftOperand, operator, rightOperand).
# Note: This shape targets rl2:AtomicConstraint specifically, not the base Condition class,
# to avoid false positives with SHACL engines that perform RDFS inference on subclasses.
rl2:AtomicConstraintShape a sh:NodeShape ;
    sh:targetClass rl2:AtomicConstraint ;
    sh:property [ sh:path rl2:leftOperand ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path rl2:constraintOperator ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rl2:ComparisonOperator ;
        sh:message "constraintOperator must be a rl2:ComparisonOperator individual (a core comparison operator or a declared rl2:ProfileOperator, RL2_Compilation.md §9.1); resolving it to a supported, in-scope operator is a compile-time check (RL2_Compilation.md §2.2), not a SHACL structural one." ] ;
    sh:property [
        sh:path rl2:targetNorm ;
        sh:maxCount 1 ;
        sh:or ( [ sh:class rl2:Norm ] [ sh:class rl2:Promise ] ) ;
        sh:message "targetNorm must reference a Norm or an Offer-local Promise."
    ] ;
    sh:xone (
        [ sh:property [
            sh:path rl2:rightOperand ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:message "rightOperand must be a literal value."
        ] ]
        [ sh:property [
            sh:path rl2:rightOperandRef ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:message "rightOperandRef must be an IRI reference."
        ] ]
        [ sh:property [
            sh:path rl2:rightOperandSet ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNode ;
            sh:class rl2:ValueSet ;
            sh:message "rightOperandSet must be one inline ValueSet."
        ] ]
    ) .

rl2:ConditionKindShape a sh:NodeShape ;
    sh:targetClass rl2:Condition ;
    sh:xone (
        [ sh:class rl2:AtomicConstraint ]
        [ sh:class rl2:LogicalConstraint ]
    ) ;
    sh:message "A Condition must be exactly one of AtomicConstraint or LogicalConstraint." .

rl2:ValueSetShape a sh:NodeShape ;
    sh:targetObjectsOf rl2:rightOperandSet ;
    sh:nodeKind sh:BlankNode ;
    sh:class rl2:ValueSet ;
    sh:property [
        sh:path rl2:valueMember ;
        sh:nodeKind sh:IRIOrLiteral ;
        sh:message "A ValueSet member must be an IRI or literal."
    ] .

# targetNorm is meaningful only for the core status operand.
rl2:StatusTargetOnlyShape a sh:NodeShape ;
    sh:targetSubjectsOf rl2:targetNorm ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "targetNorm is permitted only with obligationStateOperand." ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT $this WHERE {
                $this rl2:leftOperand ?op .
                FILTER(?op NOT IN (rl2:obligationStateOperand))
            }
        """
    ] .

# obligationStateOperand requires a Duty or Offer-local Promise target.
rl2:NormStateConstraintShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT ?this WHERE {
                ?this a rl2:AtomicConstraint ;
                      rl2:leftOperand ?op .
                FILTER(?op = rl2:obligationStateOperand)
            }
        """
    ] ;
    sh:property [
        sh:path rl2:targetNorm ;
        sh:minCount 1 ;
        sh:or ( [ sh:class rl2:Duty ] [ sh:class rl2:Promise ] ) ;
        sh:message "AtomicConstraint with obligationStateOperand must specify a Duty or Offer-local Promise targetNorm."
    ] .

# 0.7 restriction (P8): a Maintenance Duty's or Promise's invariant admits only fact-resolving
# operands and clock comparisons; obligationStateOperand is rejected there at canonical
# projection. Status operands remain permitted in applicability conditions (rl2:condition),
# which this shape does not target. Nesting inside a Condition tree uses the repeatable
# rl2:operand property (LogicalConstraint -> Condition), not an RDF list, so the property path
# (rl2:operand)* below reaches an AtomicConstraint at any nesting depth in one query; no depth
# limit is needed.
rl2:InvariantOperandRestrictionShape a sh:NodeShape ;
    sh:targetClass rl2:AtomicConstraint ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Maintenance Duty's or Promise's invariant may not contain obligationStateOperand in RL2 0.7; status operands are permitted only in applicability conditions." ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT $this WHERE {
                $this rl2:leftOperand rl2:obligationStateOperand .
                ?owner rl2:invariant ?root .
                ?root (rl2:operand)* $this .
            }
        """
    ] .

# A Promise target and every condition that queries it belong to one Offer, allowing complete
# local reference rewriting during materialization.
rl2:PromiseTargetLocalityShape a sh:NodeShape ;
    sh:targetClass rl2:AtomicConstraint ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A Promise-valued targetNorm must target a sibling Promise clause in the same Offer as the containing condition." ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT $this WHERE {
                $this rl2:targetNorm ?promise .
                ?promise a rl2:Promise .
                {
                    ?policy a rl2:Policy ;
                            rl2:condition ?root .
                }
                UNION
                {
                    ?policy rl2:clause ?owner .
                    ?owner ?conditionProperty ?root .
                    FILTER(?conditionProperty IN
                        (rl2:condition, rl2:postCondition, rl2:invariant))
                }
                UNION
                {
                    ?policy rl2:clause ?owner .
                    ?owner rl2:prerequisiteDuty ?attached .
                    ?attached ?conditionProperty ?root .
                    FILTER(?conditionProperty IN
                        (rl2:condition, rl2:postCondition, rl2:invariant))
                }
                ?root (rl2:operand)* $this .
                FILTER NOT EXISTS {
                    ?policy a rl2:Offer ;
                            rl2:clause ?promise .
                }
            }
        """
    ] .

# Logical constraints combine sub-conditions via logical operators.
# Note: The 'not' operator requires exactly one operand; 'and', 'or', 'xone' require
# at least two. The operator-specific shapes below enforce those cardinalities.
rl2:LogicalConstraintShape a sh:NodeShape ;
    sh:targetClass rl2:LogicalConstraint ;
    sh:property [ sh:path rl2:constraintOperator ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:class rl2:LogicalOperator ; sh:in (rl2:and rl2:or rl2:xone rl2:not) ] ;
    sh:property [ sh:path rl2:operand ; sh:minCount 1 ; sh:class rl2:Condition ] .

# Operand cardinalities for logical operators
rl2:NotOperandCardinalityShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT ?this WHERE {
                ?this a rl2:LogicalConstraint ;
                      rl2:constraintOperator rl2:not .
            }
        """
    ] ;
    sh:property [
        sh:path rl2:operand ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "The 'not' operator must have exactly one operand."
    ] .

rl2:AndOrXoneOperandCardinalityShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT ?this WHERE {
                ?this a rl2:LogicalConstraint ;
                      rl2:constraintOperator ?op .
                FILTER(?op IN (rl2:and, rl2:or, rl2:xone))
            }
        """
    ] ;
    sh:property [
        sh:path rl2:operand ;
        sh:minCount 2 ;
        sh:message "The 'and', 'or', and 'xone' operators must have at least two operands."
    ] .


# Asset collection shape
rl2:AssetCollectionShape a sh:NodeShape ;
    sh:targetClass rl2:AssetCollection ;
    sh:property [
        sh:path rl2:member ;
        sh:class rl2:Asset
    ] .

# Agent collection shape
rl2:AgentCollectionShape a sh:NodeShape ;
    sh:targetClass rl2:AgentCollection ;
    sh:property [
        sh:path rl2:agentMember ;
        sh:class rl2:Agent
    ] .

# Access priority validation
rl2:AccessPriorityShape a sh:NodeShape ;
    sh:targetSubjectsOf rl2:priority ;
    sh:or ( [ sh:class rl2:Privilege ] [ sh:class rl2:Prohibition ] ) ;
    sh:property [
        sh:path rl2:priority ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "Access priority must be one integer on a Privilege or Prohibition."
    ] .

############################################################
# Profile-Declared Operand Shapes
############################################################
#
# These shapes validate profile-declared left operands and their
# resolution mechanisms. Profile operands declare a resolutionPath into the snapshot.
#
# The path root validation shape ensures resolution paths use only
# canonical roots: agent, asset, state, context, request, global.

# LeftOperand shape - validates profile-declared operands
rl2:LeftOperandShape a sh:NodeShape ;
    sh:targetClass rl2:LeftOperand ;
    sh:property [
        sh:path rl2:valueType ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A LeftOperand declares at most one semantic value type via rl2:valueType."
    ] ;
    sh:property [
        sh:path rl2:resolutionPath ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^((agent|asset|context|state|global)\\.[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*|request\\.(requestingAgent|requestedAction|requestedAsset|parameters\\.[A-Za-z_][A-Za-z0-9_]*))$" ;
        sh:message "resolutionPath must be a canonical scoped path; request paths are limited to requestingAgent, requestedAction, requestedAsset, or parameters.<name>."
    ] .

# Every profile-defined operand declares its snapshot path. Core operands have built-in rules.
rl2:OperandResolutionPathShape a sh:NodeShape ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT ?this WHERE {
                ?this a rl2:LeftOperand .
                FILTER NOT EXISTS { ?this rl2:resolutionPath ?p }
                FILTER(?this NOT IN (rl2:obligationStateOperand, rl2:currentDateTime))
            }
        """
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A profile-defined LeftOperand must specify resolutionPath." ;
        sh:select """
            PREFIX rl2: <https://w3id.org/rl2#>
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this rl2:resolutionPath ?p }
            }
        """
    ] .

# AtomicConstraint leftOperand validation - ensure leftOperand is a LeftOperand
rl2:AtomicConstraintLeftOperandShape a sh:NodeShape ;
    sh:targetClass rl2:AtomicConstraint ;
    sh:property [
        sh:path rl2:leftOperand ;
        sh:class rl2:LeftOperand ;
        sh:message "leftOperand must be an instance of rl2:LeftOperand."
    ] .

rl2:RuntimeReferenceShape a sh:NodeShape ;
    sh:targetClass rl2:RuntimeReference ;
    sh:in (rl2:currentAgent) ;
    sh:message "currentAgent is the only core RuntimeReference." .

# ----------------------------------------------------------------------------
# Profile Declaration Shapes
# ----------------------------------------------------------------------------
# Structural well-formedness only. The "reject unknown required profile" rule is
# a runtime/ingestion check against the evaluator's supported-profile registry
# (which is evaluator state, not present in a single policy graph), so it cannot
# be expressed in SHACL — see RL2_Semantics.md §Profile Resolution. These shapes
# ensure the declarations themselves are well-formed enough for that check to run.

rl2:ProfileShape a sh:NodeShape ;
    sh:targetClass rl2:Profile ;
    sh:property [
        sh:path rl2:profileVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[0-9]+\\.[0-9]+\\.[0-9]+$" ;
        sh:message "A rl2:Profile must declare exactly one rl2:profileVersion as a SemVer string 'MAJOR.MINOR.PATCH'."
    ] .

rl2:RequiresProfileShape a sh:NodeShape ;
    sh:targetSubjectsOf rl2:requiresProfile ;
    sh:property [
        sh:path rl2:requiresProfile ;
        sh:class rl2:Profile ;
        sh:message "rl2:requiresProfile must reference a declared rl2:Profile (with a version), so the evaluator can run the unknown-profile / version-negotiation check."
    ] .

# A profile-declared comparison operator (RL2_Compilation.md §9.1) must carry a complete typed
# binary signature so the compile-time type stage can check operand compatibility against it.
rl2:ProfileOperatorShape a sh:NodeShape ;
    sh:targetClass rl2:ProfileOperator ;
    sh:property [
        sh:path rl2:leftParamType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A rl2:ProfileOperator must declare exactly one rl2:leftParamType."
    ] ;
    sh:property [
        sh:path rl2:rightParamType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A rl2:ProfileOperator must declare exactly one rl2:rightParamType."
    ] .

# ----------------------------------------------------------------------------
# Identity Recommendation (blank-node clause warning)
# ----------------------------------------------------------------------------
# Module-local identity (blank nodes) always exists, but cross-compile references and stable
# citation require an IRI (cf. the ODRL 2.2 odrl:uid experience: authors ignore soft
# recommendations unless validation complains). These are sh:Warning-only: a missing IRI
# degrades capability, never validity. Scoped to clause/prerequisite-Duty/Policy nodes only —
# condition substructure is deliberately not targeted.

rl2:ClauseIriRecommendationShape a sh:NodeShape ;
    sh:targetObjectsOf rl2:clause ;
    sh:severity sh:Warning ;
    sh:nodeKind sh:IRI ;
    sh:message "Clause, prerequisite Duty, and Policy nodes should be named IRIs: module-local identity always exists, but cross-compile references and stable citation require an IRI (cf. odrl:uid practice)." .

rl2:PrerequisiteDutyIriRecommendationShape a sh:NodeShape ;
    sh:targetObjectsOf rl2:prerequisiteDuty ;
    sh:severity sh:Warning ;
    sh:nodeKind sh:IRI ;
    sh:message "Clause, prerequisite Duty, and Policy nodes should be named IRIs: module-local identity always exists, but cross-compile references and stable citation require an IRI (cf. odrl:uid practice)." .

rl2:PolicyIriRecommendationShape a sh:NodeShape ;
    sh:targetClass rl2:Policy ;
    sh:severity sh:Warning ;
    sh:nodeKind sh:IRI ;
    sh:message "Clause, prerequisite Duty, and Policy nodes should be named IRIs: module-local identity always exists, but cross-compile references and stable citation require an IRI (cf. odrl:uid practice)." .
