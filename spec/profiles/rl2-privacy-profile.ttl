@base <https://w3id.org/rl2/profiles/privacy#> .
@prefix privacy: <https://w3id.org/rl2/profiles/privacy#> .
@prefix rl2: <https://w3id.org/rl2#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<https://w3id.org/rl2/profiles/privacy>
    a owl:Ontology, rl2:Profile ;
    rdfs:label "RL2 Privacy Profile" ;
    dc:description "Illustrative operands, value classes, and actions for privacy policies." ;
    rl2:profileVersion "0.1.0" ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/rl2/0.7> .

############################################################
# Operands
############################################################

privacy:dataOwnerOperand a rl2:LeftOperand ;
    rdfs:label "Data subject" ;
    rdfs:comment "Agent to whom the requested personal-data asset relates." ;
    rl2:resolutionPath "asset.dataOwner" ;
    rl2:valueType rl2:Agent .

privacy:dataControllerOperand a rl2:LeftOperand ;
    rdfs:label "Data controller" ;
    rdfs:comment "Controller responsible for the requested asset." ;
    rl2:resolutionPath "asset.controller" ;
    rl2:valueType rl2:Agent .

privacy:dataProcessorOperand a rl2:LeftOperand ;
    rdfs:label "Data processor" ;
    rdfs:comment "Processor identified for the evaluation context." ;
    rl2:resolutionPath "context.processor" ;
    rl2:valueType rl2:Agent .

privacy:purposeOperand a rl2:LeftOperand ;
    rdfs:label "Requested purpose" ;
    rl2:resolutionPath "context.purpose" ;
    rl2:valueType privacy:Purpose .

privacy:originalPurposeOperand a rl2:LeftOperand ;
    rdfs:label "Collection purpose" ;
    rl2:resolutionPath "asset.collectionPurpose" ;
    rl2:valueType privacy:Purpose .

privacy:consentStatusOperand a rl2:LeftOperand ;
    rdfs:label "Consent status" ;
    rl2:resolutionPath "asset.consentRecord.status" ;
    rl2:valueType privacy:ConsentStatus .

privacy:consentPurposeOperand a rl2:LeftOperand ;
    rdfs:label "Consent purpose" ;
    rl2:resolutionPath "asset.consentRecord.purpose" ;
    rl2:valueType privacy:Purpose .

privacy:consentExpiryOperand a rl2:LeftOperand ;
    rdfs:label "Consent expiry" ;
    rl2:resolutionPath "asset.consentRecord.expiryDate" ;
    rl2:valueType xsd:dateTimeStamp .

privacy:dataClassificationOperand a rl2:LeftOperand ;
    rdfs:label "Data classification" ;
    rl2:resolutionPath "asset.classification" ;
    rl2:valueType privacy:DataClassification .

privacy:specialCategoryOperand a rl2:LeftOperand ;
    rdfs:label "Special-category data" ;
    rl2:resolutionPath "asset.isSpecialCategory" ;
    rl2:valueType xsd:boolean .

privacy:dataLocationOperand a rl2:LeftOperand ;
    rdfs:label "Storage jurisdiction" ;
    rl2:resolutionPath "asset.storageLocation" ;
    rl2:valueType privacy:Jurisdiction .

privacy:processingLocationOperand a rl2:LeftOperand ;
    rdfs:label "Processing jurisdiction" ;
    rl2:resolutionPath "context.processingLocation" ;
    rl2:valueType privacy:Jurisdiction .

privacy:dataSubjectLocationOperand a rl2:LeftOperand ;
    rdfs:label "Data-subject jurisdiction" ;
    rl2:resolutionPath "asset.dataSubjectLocation" ;
    rl2:valueType privacy:Jurisdiction .

privacy:retentionExpiryOperand a rl2:LeftOperand ;
    rdfs:label "Retention expiry" ;
    rl2:resolutionPath "asset.retentionExpiry" ;
    rl2:valueType xsd:dateTimeStamp .

privacy:collectionDateOperand a rl2:LeftOperand ;
    rdfs:label "Collection date" ;
    rl2:resolutionPath "asset.collectionDate" ;
    rl2:valueType xsd:dateTimeStamp .

privacy:lawfulBasisOperand a rl2:LeftOperand ;
    rdfs:label "Declared lawful basis" ;
    rl2:resolutionPath "context.lawfulBasis" ;
    rl2:valueType privacy:LawfulBasis .

############################################################
# Value vocabularies
############################################################

privacy:Purpose a owl:Class ; rdfs:label "Purpose" .
privacy:Research a privacy:Purpose ; rdfs:label "Research" .
privacy:Marketing a privacy:Purpose ; rdfs:label "Marketing" .
privacy:ServiceProvision a privacy:Purpose ; rdfs:label "Service provision" .
privacy:LegalObligation a privacy:Purpose ; rdfs:label "Legal obligation" .
privacy:VitalInterest a privacy:Purpose ; rdfs:label "Vital interest" .
privacy:PublicInterest a privacy:Purpose ; rdfs:label "Public interest" .
privacy:LegitimateInterest a privacy:Purpose ; rdfs:label "Legitimate interest" .

privacy:ConsentStatus a owl:Class ; rdfs:label "Consent status" .
privacy:ConsentGranted a privacy:ConsentStatus ; rdfs:label "Granted" .
privacy:ConsentWithdrawn a privacy:ConsentStatus ; rdfs:label "Withdrawn" .
privacy:ConsentExpired a privacy:ConsentStatus ; rdfs:label "Expired" .
privacy:ConsentNotRequired a privacy:ConsentStatus ; rdfs:label "Not required" .

privacy:DataClassification a owl:Class ; rdfs:label "Data classification" .
privacy:Public a privacy:DataClassification ; rdfs:label "Public" .
privacy:Internal a privacy:DataClassification ; rdfs:label "Internal" .
privacy:Confidential a privacy:DataClassification ; rdfs:label "Confidential" .
privacy:Sensitive a privacy:DataClassification ; rdfs:label "Sensitive" .

privacy:Jurisdiction a owl:Class ; rdfs:label "Jurisdiction category" .
privacy:EU a privacy:Jurisdiction ; rdfs:label "European Union" .
privacy:EEA a privacy:Jurisdiction ; rdfs:label "European Economic Area" .
privacy:Adequacy a privacy:Jurisdiction ; rdfs:label "Adequate jurisdiction" .
privacy:ThirdCountry a privacy:Jurisdiction ; rdfs:label "Third country" .

privacy:LawfulBasis a owl:Class ; rdfs:label "Lawful basis category" .
privacy:Consent a privacy:LawfulBasis ; rdfs:label "Consent" .
privacy:Contract a privacy:LawfulBasis ; rdfs:label "Contract" .
privacy:LegalObligationBasis a privacy:LawfulBasis ; rdfs:label "Legal obligation" .
privacy:VitalInterestBasis a privacy:LawfulBasis ; rdfs:label "Vital interest" .
privacy:PublicInterestBasis a privacy:LawfulBasis ; rdfs:label "Public interest" .
privacy:LegitimateInterestBasis a privacy:LawfulBasis ; rdfs:label "Legitimate interest" .

############################################################
# Actions
############################################################

privacy:collect a rl2:Action ; rdfs:label "Collect" .
privacy:process a rl2:Action ; rdfs:label "Process" .
privacy:store a rl2:Action ; rdfs:label "Store" .
privacy:transfer a rl2:Action ; rdfs:label "Transfer" .
privacy:transferInternational a rl2:Action ;
    rl2:includedIn privacy:transfer ;
    rdfs:label "International transfer" .
privacy:delete a rl2:Action ; rdfs:label "Delete" .
privacy:rectify a rl2:Action ; rdfs:label "Rectify" .
privacy:access a rl2:Action ; rdfs:label "Access" .
privacy:export a rl2:Action ; rdfs:label "Export" .
privacy:anonymize a rl2:Action ; rdfs:label "Anonymize" .
privacy:pseudonymize a rl2:Action ; rdfs:label "Pseudonymize" .

# This vocabulary supplies policy terms, not a claim of legal compliance. A profile user must
# define the authoritative facts, evidence, and jurisdiction-specific rules used by each policy.
