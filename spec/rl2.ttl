@base <https://w3id.org/rl2#> .
@prefix rl2: <https://w3id.org/rl2#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .

<https://w3id.org/rl2>
  a owl:Ontology ;
  rdfs:label "RL2 Ontology" ;
  dc:description "A deterministic policy language extending and clarifying ODRL 2.2." ;
  owl:versionInfo "0.7" ;
  owl:versionIRI <https://w3id.org/rl2/0.7> .

############################################################
# 1. Normative Clauses
############################################################

# A Clause is a Norm or Promise that may occur in a policy.
rl2:Clause a owl:Class ;
    rdfs:label "Clause" ;
    rdfs:comment "A Norm or a Promise — the admissible content of a policy clause." .

# Norms represent conduct relations between agents, actions, and assets.
rl2:Norm a owl:Class ;
    rdfs:subClassOf rl2:Clause ;
    rdfs:label "Norm" ;
    rdfs:comment "An operative conduct relation evaluated by RL2." .

rl2:Privilege a owl:Class ;
    rdfs:subClassOf rl2:Norm ;
    rdfs:label "Privilege" ;
    rdfs:comment "Authorization for the subject to perform an action on an asset." .

rl2:Duty a owl:Class ;
    rdfs:subClassOf rl2:Norm ;
    rdfs:label "Duty" ;
    rdfs:comment """An obligation imposed on an agent. A canonical Duty has exactly one
    content form: an Achievement Duty requires an rl2:action and may declare an
    rl2:postCondition; a Maintenance Duty requires an rl2:invariant and has no action.
    The form determines the status semantics; no separate mode is authored.""" .

rl2:Prohibition a owl:Class ;
    rdfs:subClassOf rl2:Norm ;
    rdfs:label "Prohibition" ;
    rdfs:comment "A prohibition on performing an action." .

[] a owl:AllDisjointClasses ;
    owl:members (rl2:Privilege rl2:Duty rl2:Prohibition) .

rl2:priority a owl:DatatypeProperty ;
    rdfs:domain [ owl:unionOf (rl2:Privilege rl2:Prohibition) ] ;
    rdfs:range xsd:integer ;
    rdfs:label "Priority" ;
    rdfs:comment """Numeric priority for conflict resolution; higher values override lower.
    When multiple norms apply to the same request with conflicting effects,
    the norm with higher priority prevails. Default priority is 0 if unspecified.""" .

############################################################
# 2. Proposed Commitments
############################################################

rl2:Promise a owl:Class ;
    rdfs:subClassOf rl2:Clause ;
    rdfs:label "Promise" ;
    owl:disjointWith rl2:Norm ;
    rdfs:comment """A Promise is a proposed Duty: it carries Duty-shaped content (rl2:subject as
    the promisor, rl2:counterparty as the promisee, rl2:object, exactly one of rl2:action or
    rl2:invariant, an optional rl2:condition, and an optional rl2:dutyWindow) but occurs only in
    an Offer and is not itself operative. An action commitment (rl2:action) is fulfilled when the
    promisor has performed the action (subsumption-aware, per the evidence selector in
    RL2_Semantics) and crystallizes to an Achievement Duty on acceptance. A state commitment
    (rl2:invariant) has its snapshot-derived status follow that condition and crystallizes to a
    Maintenance Duty on acceptance, with the accepted Duty's rl2:dutyWindow setting any warranty
    period. Unlike on a Duty, a Promise's rl2:counterparty is required and its rl2:object is
    optional (it may be left for Acceptance to bind).""" .

############################################################
# 3. Agents and Roles
############################################################

rl2:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "Any party participating in a normative or functional role." .

rl2:AgentCollection a owl:Class ;
    rdfs:subClassOf rl2:Agent ;
    rdfs:label "Agent Collection" ;
    rdfs:comment """A collection that may itself be the subject of a norm or a member of
    another collection. Core request matching uses direct membership only.""" .

rl2:anyAgent a rl2:Agent ;
    rdfs:label "Any Agent" ;
    rdfs:comment """Distinguished sentinel individual. A norm's rl2:subject rl2:anyAgent
    matches every requesting agent; the population is delimited by conditions over
    agent.* facts, not by matching. It may not appear as a member of an AgentCollection
    and may not be a Request's requestingAgent. A Duty MAY carry rl2:anyAgent as its
    subject: it is then a template, bound to the concrete requesting or matched agent via
    bind() (RL2_Semantics.md) wherever the Duty is consulted or emitted in a request
    context; no sentinel ever appears in an emitted envelope atom or dutyStatus query.""" .

# Normative roles (core semantic roles)
rl2:subject a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Norm rl2:Promise) ] ;
    rdfs:range rl2:Agent ;
    rdfs:comment "The agent bearing the normative status; on a Promise, the promisor." .

rl2:counterparty a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Duty rl2:Promise) ] ;
    rdfs:range rl2:Agent ;
    rdfs:comment "The beneficiary or other agent to whom a Duty is owed; on a Promise, the promisee." .

# Functional (syntactic) roles
rl2:grantor a owl:ObjectProperty ;
    rdfs:domain rl2:Policy ;
    rdfs:range rl2:Agent ;
    rdfs:comment "Agent proposing an Offer or granting the terms of an Agreement." .

rl2:grantee a owl:ObjectProperty ;
    rdfs:domain rl2:Policy ;
    rdfs:range rl2:Agent ;
    rdfs:comment "Agent addressed by an Offer or receiving the terms of an Agreement." .

############################################################
# 4. Actions, Assets, Conditions
############################################################

rl2:Action a owl:Class ;
    rdfs:label "Action" ;
    rdfs:comment """An action that may be performed on an asset.
    RL2 Core does not define specific action instances; these are provided
    by profiles tailored to specific domains. For example:
    - A media licensing profile might define: play, stream, display, reproduce
    - A software license profile might define: execute, install, modify
    - A data governance profile might define: process, transfer, anonymize
    Profiles define actions as individuals of this class.""" .

rl2:Asset a owl:Class ;
    rdfs:label "Asset" ;
    rdfs:comment "A resource or object subject to normative control." .

rl2:AssetCollection a owl:Class ;
    rdfs:subClassOf rl2:Asset ;
    rdfs:label "Asset Collection" ;
    rdfs:comment """A collection that may itself be the object of a norm or a member of
    another collection. Core request matching uses direct membership only.""" .

rl2:anyAsset a rl2:Asset ;
    rdfs:label "Any Asset" ;
    rdfs:comment """Distinguished sentinel individual. A norm's rl2:object rl2:anyAsset
    matches every requested asset; the population is delimited by conditions over
    asset.* facts, not by matching. It may not appear as a member of an AssetCollection
    and may not be a Request's requestedAsset. A Duty MAY carry rl2:anyAsset as its
    object: it is then a template, bound to the concrete requested or matched asset via
    bind() (RL2_Semantics.md) wherever the Duty is consulted or emitted in a request
    context; no sentinel ever appears in an emitted envelope atom or dutyStatus query.""" .

rl2:Condition a owl:Class ;
    rdfs:label "Condition" ;
    rdfs:comment "A constraint or requirement that must hold for a norm to be active." .

rl2:AtomicConstraint a owl:Class ;
    rdfs:subClassOf rl2:Condition ;
    rdfs:label "Atomic Constraint" ;
    rdfs:comment """A simple comparison constraint with left operand, operator, and right operand.
    Use this class for basic conditions like 'purpose eq research' or 'count lte 10'.
    For compound conditions, use LogicalConstraint.
    For time-based conditions, use rl2:currentDateTime operand with comparison operators.""" .

rl2:LogicalConstraint a owl:Class ;
    rdfs:subClassOf rl2:Condition ;
    rdfs:label "Logical Constraint" ;
    rdfs:comment "A condition combining other conditions via logical operators." .

rl2:AtomicConstraint owl:disjointWith rl2:LogicalConstraint .

rl2:RuntimeReference a owl:Class ;
    rdfs:label "Runtime Reference" ;
    rdfs:comment """A value reference resolved at evaluation time.
    Used in rightOperandRef of AtomicConstraints for dynamic comparisons.
    
    Core instance: rl2:currentAgent (resolves to Env.Agent).
    
    For left-side dynamic values, use LeftOperand with resolutionPath instead.""" .

# Norm-Targeted Constraints (for querying duty/norm state)
rl2:targetNorm a owl:ObjectProperty ;
    rdfs:domain rl2:AtomicConstraint ;
    rdfs:label "Target Norm" ;
    rdfs:comment """Specifies the norm (or, pre-acceptance inside an Offer, the promise)
    whose derived status is being queried, always via rl2:obligationStateOperand. When present,
    resolve(leftOperand) evaluates this specific norm or promise.
    An Offer-stage clause may target a sibling Promise before it has crystallized. The
    targeted Promise and the condition containing this reference MUST belong to the same
    Offer; cross-policy Promise references are invalid.
    On Agreement formation, materialize() (RL2_Semantics.md
    §Pure Offer Acceptance) rebinds a targetNorm that pointed at an Offer-local Promise to
    the crystallized Duty; the obligationStateOperand itself does not change. An Agreement's
    targetNorm usage is therefore Norm-valued; no Promise survives materialization. SHACL
    validates the target type.""" .

# Left operands for norm state queries
rl2:obligationStateOperand a rl2:LeftOperand ;
    rdfs:label "Obligation State Operand" ;
    rl2:valueType rl2:ObligationState ;
    rdfs:comment """Queries the derived status of the norm or Offer-local Promise named by
    rl2:targetNorm, as derived from policy content and the immutable WorldSnapshot.
    Returns Pending, Active, Fulfilled, or Violated for a Duty target; Pending, Fulfilled, or
    Violated (never Active) for a Promise target.
    Requires rl2:targetNorm to specify which Duty or Promise to query.""" .

rl2:currentDateTime a rl2:LeftOperand ;
    rdfs:label "Current Date Time" ;
    rl2:valueType xsd:dateTimeStamp ;
    rdfs:comment """Resolves to WorldSnapshot.evaluationTime.
    Used in AtomicConstraints for temporal validity checks.
    Example: currentDateTime lte "2025-01-01T00:00:00Z"^^xsd:dateTimeStamp
    Resolution path: 'state.Clock'.
    valueType is xsd:dateTimeStamp (timezone-mandatory), not xsd:dateTime:
    a total instant ordering requires every compared instant to carry a
    timezone offset. Ingestion MUST normalize bare xsd:dateTime literals
    compared against this operand to xsd:dateTimeStamp before evaluation.
    The compile pass rejects a rightOperand literal whose datatype does
    not match.""" ;
    rl2:resolutionPath "state.Clock" .

# Dynamic reference for current agent
rl2:currentAgent a rl2:RuntimeReference ;
    rdfs:label "Current Agent" ;
    rdfs:comment """Resolves to Request.requestingAgent. It may be used as rightOperandRef
    for a dynamic identity comparison, such as asset.dataOwner eq currentAgent.""" .

rl2:includedIn a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:domain rl2:Action ;
    rdfs:range rl2:Action ;
    rdfs:label "Included In" ;
    rdfs:comment """Action taxonomy: A includedIn B means A is a narrower action
    included within B. Transitive: if A includedIn B and B includedIn C,
    then A includedIn C. Used for action subsumption in norm matching.
    Profiles define action hierarchies using this property.
    Do NOT use rdfs:subClassOf for action hierarchies.""" .

rl2:action a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Norm rl2:Promise) ] ;
    rdfs:range rl2:Action ;
    rdfs:comment "Action specified in a norm — the authorized action for a Privilege, the prohibited action for a Prohibition, or the required action for an Achievement Duty; on a Promise, the promised action, which crystallizes to an Achievement Duty." .

rl2:object a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Norm rl2:Promise) ] ;
    rdfs:range rl2:Asset ;
    rdfs:comment "Asset specified in a norm or Promise; an Offer may leave an action/state Promise object for Acceptance binding." .

rl2:member a owl:ObjectProperty ;
    rdfs:domain rl2:AssetCollection ;
    rdfs:range rl2:Asset ;
    rdfs:comment """Direct membership relation for asset collections. Core semantics
    read rl2:member links directly (not transitively closed); because the range is
    rl2:Asset and AssetCollection ⊑ Asset, a member may itself be a collection, but
    core matching does NOT auto-flatten such nesting — that is a profile/derived
    concern. Membership is read from the canonical PolicyUniverse.""" .

rl2:agentMember a owl:ObjectProperty ;
    rdfs:domain rl2:AgentCollection ;
    rdfs:range rl2:Agent ;
    rdfs:comment """Direct membership relation for agent collections. Core semantics
    read rl2:agentMember links directly (not transitively closed); because the range is
    rl2:Agent and AgentCollection ⊑ Agent, a member may itself be a collection, but
    core matching does NOT auto-flatten such nesting — that is a profile/derived
    concern. Membership is read from the canonical PolicyUniverse.""" .

rl2:condition a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Norm rl2:Policy rl2:Promise) ] ;
    rdfs:range rl2:Condition ;
    rdfs:comment """Applicability condition for a norm or policy. It determines whether
    the normative proposition applies; it does not define Duty satisfaction. On an Offer it
    denotes the applicability guard proposed for the resulting Agreement, not offer validity
    or acceptance authorization. Achievement completion uses rl2:action and optional
    rl2:postCondition. Maintenance content uses rl2:invariant.""" .

rl2:prerequisiteDuty a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Privilege rl2:Policy) ] ;
    rdfs:range rl2:Duty ;
    rdfs:label "Prerequisite Duty" ;
    rdfs:comment """Associates a Privilege or a Policy with a Duty that, when applicable, must
    be Fulfilled before an access decision can grant a permit. On a Privilege, the Duty gates
    that Privilege. On a Policy, the Duty gates every Privilege clause of that Policy. Sharing
    one Duty node means one fulfillment result gates every owner, matching ODRL 2.2. Multiple
    prerequisiteDuty values (on one Privilege, on one Policy, or across both) are conjunctive. A
    prerequisite Duty may simultaneously be an independent rl2:clause of a Policy: it then also
    contributes its obligation atom independently, in addition to gating its referencing
    owner(s). Ongoing or post-use enforcement is outside core Eval.""" .

rl2:consequentDuty a owl:ObjectProperty ;
    rdfs:domain rl2:Privilege ;
    rdfs:range rl2:Duty ;
    rdfs:label "Consequent Duty" ;
    rdfs:comment """Associates a Privilege with a Duty that fires alongside it: when the
    Privilege fires for a request, the referenced Duty's obligate atom is emitted into the
    normative envelope, with sentinel substitution per the bind() rule (RL2_Semantics.md).
    Unlike rl2:prerequisiteDuty, a consequentDuty does not gate the decision — it is a
    post-use or companion obligation (e.g. attribution, logging) triggered by the grant, not
    a precondition to it. Pairs with rl2:prerequisiteDuty as the pre/post counterpart on a
    Privilege. Deliberately not widened to rl2:Policy: unlike a gating prerequisite, a
    consequent obligation is tied to the specific Privilege clause that fired, not to every
    Privilege of a Policy.""" .

rl2:postCondition a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Duty rl2:Promise) ] ;
    rdfs:range rl2:Condition ;
    rdfs:label "Postcondition" ;
    rdfs:comment """Optional condition that must hold at the qualifying action witness
    for an Achievement Duty to be fulfilled. It is not an applicability condition and
    is not permitted on a Maintenance Duty. On an action-form Promise it is the proposed
    post-state check, copied unevaluated into the crystallized Achievement Duty at
    materialization; a state-form Promise may not carry one.""" .

rl2:invariant a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Duty rl2:Promise) ] ;
    rdfs:range rl2:Condition ;
    rdfs:label "Invariant" ;
    rdfs:comment """Condition that must hold throughout a Maintenance Duty's dutyWindow.
    Without a dutyWindow it is an ongoing condition assessed at the current snapshot. A Duty
    with an invariant has no action or postCondition. Complete temporal coverage, not a point
    observation at evaluation time, is required to fulfill a windowed Maintenance Duty. On a
    Promise, the promised state, which crystallizes to a Maintenance Duty's invariant. 0.7
    restriction: an invariant admits only fact-resolving operands and currentDateTime;
    obligationStateOperand is rejected here (still permitted in rl2:condition) — see
    RL2_Semantics.md and rl2:InvariantOperandRestrictionShape.""" .

rl2:DutyWindow a owl:Class ;
    rdfs:label "Duty Window" ;
    rdfs:comment """A finite half-open interval [startInclusive, endExclusive) during
    which one Duty occurrence is assessed. Recurrence is represented by distinct Duty
    occurrences, not by resetting a status or repeating this interval inside Eval. A
    DutyWindow denotes exactly ONE such interval; recurring obligations (e.g. "every Monday at
    8am") are out of scope for 0.7 — see RL2_Semantics.md. Each endpoint (start, end) is
    independently either Absolute (a literal instant: startInclusive/endExclusive) or Relative
    (an anchor operand plus an offset: startRelativeTo+startOffset, endRelativeTo+endOffset).""" .

rl2:dutyWindow a owl:ObjectProperty ;
    rdfs:domain [ owl:unionOf (rl2:Duty rl2:Promise) ] ;
    rdfs:range rl2:DutyWindow ;
    rdfs:label "Duty Window" ;
    rdfs:comment """The optional finite assessment interval for this Duty occurrence.
    An Achievement Duty without a window can be fulfilled but does not become Violated
    merely through passage of time. A Maintenance Duty without a window can be Active or
    Violated but cannot become Fulfilled. On a Promise, the window is carried unevaluated to
    the materialized Duty; it is not assessed pre-acceptance.""" .

rl2:startInclusive a owl:DatatypeProperty ;
    rdfs:domain rl2:DutyWindow ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:label "Start Inclusive" ;
    rdfs:comment """Inclusive start instant of a DutyWindow, when the start endpoint is
    Absolute. Mutually exclusive with startRelativeTo/startOffset.""" .

rl2:endExclusive a owl:DatatypeProperty ;
    rdfs:domain rl2:DutyWindow ;
    rdfs:range xsd:dateTimeStamp ;
    rdfs:label "End Exclusive" ;
    rdfs:comment """Exclusive end instant of a DutyWindow, when the end endpoint is
    Absolute. Mutually exclusive with endRelativeTo/endOffset.""" .

rl2:startRelativeTo a owl:ObjectProperty ;
    rdfs:domain rl2:DutyWindow ;
    rdfs:range rl2:LeftOperand ;
    rdfs:label "Start Relative To" ;
    rdfs:comment """Anchor operand for a Relative start endpoint, paired with startOffset.
    The anchor resolves once per evaluation via resolveFact and must resolve to a DateTime; the
    resolved window start is the anchor's value plus startOffset. Mutually exclusive with
    startInclusive. A Missing or non-DateTime anchor leaves the window unresolved, and the
    Duty's/Promise's status is IndeterminateStatus (see RL2_Semantics.md resolveWindow).""" .

rl2:startOffset a owl:DatatypeProperty ;
    rdfs:domain rl2:DutyWindow ;
    rdfs:range xsd:dayTimeDuration ;
    rdfs:label "Start Offset" ;
    rdfs:comment "Duration added to startRelativeTo's resolved instant. Requires startRelativeTo." .

rl2:endRelativeTo a owl:ObjectProperty ;
    rdfs:domain rl2:DutyWindow ;
    rdfs:range rl2:LeftOperand ;
    rdfs:label "End Relative To" ;
    rdfs:comment """Anchor operand for a Relative end endpoint, paired with endOffset. The
    anchor resolves once per evaluation via resolveFact and must resolve to a DateTime; the
    resolved window end is the anchor's value plus endOffset. Mutually exclusive with
    endExclusive. A Missing or non-DateTime anchor leaves the window unresolved, and the
    Duty's/Promise's status is IndeterminateStatus (see RL2_Semantics.md resolveWindow).""" .

rl2:endOffset a owl:DatatypeProperty ;
    rdfs:domain rl2:DutyWindow ;
    rdfs:range xsd:dayTimeDuration ;
    rdfs:label "End Offset" ;
    rdfs:comment "Duration added to endRelativeTo's resolved instant. Requires endRelativeTo." .

rl2:LeftOperand a owl:Class ;
    rdfs:label "Left Operand" ;
    rdfs:comment """A property or attribute to be evaluated in a condition.
    RL2 Core defines currentDateTime and the targeted Duty/Promise operands.
    Profiles provide domain operands such as purpose, spatial, recipient,
    payAmount, and fileFormat.

    A profile-defined operand used by core Eval MUST specify rl2:resolutionPath so its
    policy-visible data dependency is declared, typed, and validatable.""" .

# Profile operand resolution
#
# Each profile operand declares the snapshot path interpreted by resolve/deref.

rl2:resolutionPath a owl:DatatypeProperty ;
    rdfs:domain rl2:LeftOperand ;
    rdfs:range xsd:string ;
    rdfs:label "Resolution Path" ;
    rdfs:comment """Canonical scoped key used to resolve this operand from the immutable
    WorldSnapshot via deref(). It is not a live host-object traversal.

    Canonical path roots (normatively defined):
    - agent.*    : facts scoped to Request.requestingAgent
    - asset.*    : facts scoped to Request.requestedAsset
    - state.*    : StateScope facts; state.Clock has a fixed core meaning
    - context.*  : EvaluationScope facts (purpose, jurisdiction, etc.)
    - request.*  : requestingAgent, requestedAction, requestedAsset, or parameters.<name> in core
    - global.*   : caller-supplied aggregate facts in GlobalScope

    Examples:
    - 'agent.department'
    - 'asset.classification'
    - 'asset.dataOwner'
    - 'context.purpose'
    - 'state.Clock'
    - 'global.activeSessions.count'

    Resolution semantics are defined by deref(path, leftOperand, Env) in RL2_Semantics.
    SECURITY: Implementations MUST validate paths against allowed roots.""" .

rl2:valueType a owl:ObjectProperty ;
    rdfs:domain rl2:LeftOperand ;
    rdfs:label "Value Type" ;
    rdfs:comment """Declares the operand's value type for the compile-time typing pass: a
    datatype IRI (e.g. xsd:dateTimeStamp, xsd:boolean) or a profile-defined value class (e.g.
    privacy:Purpose). No rdfs:range is declared for rl2:valueType itself, because its values are
    heterogeneous — datatype IRIs and classes both occur, and neither alone is the range.
    Replaces the earlier use of rdfs:range on operand individuals, which is now tolerated
    documentation only. An operand used in a policy without a declared valueType is a compile
    error.""" .

rl2:leftOperand a owl:ObjectProperty ;
    rdfs:domain rl2:Condition ;
    rdfs:range rl2:LeftOperand ;
    rdfs:comment "Left operand of a condition (the property being evaluated)." .

rl2:constraintOperator a owl:ObjectProperty ;
    rdfs:domain rl2:Condition ;
    rdfs:range rl2:Operator ;
    rdfs:comment "Operator of a condition; may be a ComparisonOperator or LogicalOperator." .

rl2:rightOperand a owl:DatatypeProperty ;
    rdfs:domain rl2:Condition ;
    rdfs:comment "Right operand of a condition (literal value)." .

rl2:rightOperandRef a owl:ObjectProperty ;
    rdfs:domain rl2:Condition ;
    rdfs:comment "Right operand represented by an IRI constant or RuntimeReference." .

rl2:ValueSet a owl:Class ;
    rdfs:label "Value Set" ;
    rdfs:comment "Finite set used as the right operand of a set comparison." .

rl2:rightOperandSet a owl:ObjectProperty ;
    rdfs:domain rl2:Condition ;
    rdfs:range rl2:ValueSet ;
    rdfs:comment "Inline finite set used as the right operand of a condition." .

rl2:valueMember a rdf:Property ;
    rdfs:domain rl2:ValueSet ;
    rdfs:comment "Literal or IRI member of a ValueSet." .

rl2:operand a owl:ObjectProperty ;
    rdfs:domain rl2:LogicalConstraint ;
    rdfs:range rl2:Condition ;
    rdfs:comment "A sub-condition operand of a logical constraint." .

# Operator Type Hierarchy
rl2:Operator a owl:Class ;
    rdfs:label "Operator" ;
    rdfs:comment "Abstract class for constraint operators." .

rl2:LogicalOperator a owl:Class ;
    rdfs:subClassOf rl2:Operator ;
    rdfs:label "Logical Operator" ;
    rdfs:comment "Operators for combining conditions (and, or, xone, not)." ;
    owl:oneOf (rl2:and rl2:or rl2:xone rl2:not) .

rl2:ComparisonOperator a owl:Class ;
    rdfs:subClassOf rl2:Operator ;
    rdfs:label "Comparison Operator" ;
    rdfs:comment """Operators for comparing values. Core defines ten individuals (eq, neq, lt,
    lte, gt, gte, isA, isAnyOf, isAllOf, isNoneOf); a profile may add rl2:ProfileOperator
    individuals. Deliberately NOT an owl:oneOf enumeration: the closed-operator check is owned
    by the compile phase (RL2_Compilation.md, UnknownOperator), and a closed nominal class
    would contradict profile-declared operators.""" .

# Logical Operators
rl2:and a rl2:LogicalOperator ;
    rdfs:label "and" ;
    rdfs:comment "Logical conjunction: all sub-conditions must hold." .

rl2:or a rl2:LogicalOperator ;
    rdfs:label "or" ;
    rdfs:comment "Logical disjunction: at least one sub-condition must hold." .

rl2:xone a rl2:LogicalOperator ;
    rdfs:label "xone" ;
    rdfs:comment "Exclusive or: exactly one sub-condition must hold." .

rl2:not a rl2:LogicalOperator ;
    rdfs:label "not" ;
    rdfs:comment "Logical negation: the sub-condition must not hold. Requires exactly one operand." .

# Comparison Operators
rl2:eq a rl2:ComparisonOperator ;
    rdfs:label "eq" ;
    rdfs:comment "Equality comparison." .

rl2:neq a rl2:ComparisonOperator ;
    rdfs:label "neq" ;
    rdfs:comment "Inequality comparison." .

rl2:lt a rl2:ComparisonOperator ;
    rdfs:label "lt" ;
    rdfs:comment "Less-than comparison." .

rl2:lte a rl2:ComparisonOperator ;
    rdfs:label "lte" ;
    rdfs:comment "Less-than-or-equal comparison." .

rl2:gt a rl2:ComparisonOperator ;
    rdfs:label "gt" ;
    rdfs:comment "Greater-than comparison." .

rl2:gte a rl2:ComparisonOperator ;
    rdfs:label "gte" ;
    rdfs:comment "Greater-than-or-equal comparison." .

rl2:isA a rl2:ComparisonOperator ;
    rdfs:label "isA" ;
    rdfs:comment "Type/class membership check." .

rl2:isAnyOf a rl2:ComparisonOperator ;
    rdfs:label "isAnyOf" ;
    rdfs:comment "Value is any of a specified set." .

rl2:isAllOf a rl2:ComparisonOperator ;
    rdfs:label "isAllOf" ;
    rdfs:comment "Value satisfies all of a specified set." .

rl2:isNoneOf a rl2:ComparisonOperator ;
    rdfs:label "isNoneOf" ;
    rdfs:comment "Value is none of a specified set." .

# Profile Operators (RL2_Compilation.md §9.1)
#
# A profile may declare its own comparison operator instead of being limited to the ten operators
# above. rl2:ProfileOperator is a subclass of rl2:ComparisonOperator (the class every core
# comparison operator individual is typed as), so a declared profile operator individual is usable
# anywhere rl2:constraintOperator admits a rl2:ComparisonOperator. Conformance for a profile's
# operators is established by that profile's own vectors, per RL2_Compilation.md.
rl2:ProfileOperator a owl:Class ;
    rdfs:subClassOf rl2:ComparisonOperator ;
    rdfs:label "Profile Operator" ;
    rdfs:comment "Profile-declared comparison operator with a typed binary signature (leftParamType, rightParamType). Distinct from the fixed, enumerated core comparison operators: a profile may declare any number of these, each compiled and digest-bound with the rest of its profile." .

rl2:leftParamType a owl:ObjectProperty ;
    rdfs:domain rl2:ProfileOperator ;
    rdfs:label "Left Parameter Type" ;
    rdfs:comment """Declares the value type (a datatype IRI or profile value class) admitted as
    a rl2:ProfileOperator's left-hand operand. No rdfs:range is declared for rl2:leftParamType
    itself, because its values are heterogeneous — datatype IRIs and classes both occur, and
    neither alone is the range (the same rationale as rl2:valueType). Every rl2:ProfileOperator
    declares exactly one.""" .

rl2:rightParamType a owl:ObjectProperty ;
    rdfs:domain rl2:ProfileOperator ;
    rdfs:label "Right Parameter Type" ;
    rdfs:comment """Declares the value type (a datatype IRI or profile value class) admitted as
    a rl2:ProfileOperator's right-hand operand. No rdfs:range is declared for rl2:rightParamType
    itself, for the same reason as rl2:leftParamType and rl2:valueType. Every rl2:ProfileOperator
    declares exactly one.""" .

# Obligation States (enumeration pattern)
rl2:ObligationState a owl:Class ;
    rdfs:label "Obligation State" ;
    rdfs:comment "State of a duty: pending, active, fulfilled, violated." ;
    owl:oneOf (rl2:Pending rl2:Active rl2:Fulfilled rl2:Violated) .

rl2:Pending a rl2:ObligationState ;
    rdfs:label "Pending" ;
    rdfs:comment "The Duty is not currently applicable or its window has not started, or a Promise has not yet been fulfilled." .

rl2:Active a rl2:ObligationState ;
    rdfs:label "Active" ;
    rdfs:comment "The Duty is currently in force and is neither Fulfilled nor Violated." .

rl2:Fulfilled a rl2:ObligationState ;
    rdfs:label "Fulfilled" ;
    rdfs:comment "Duty has been satisfied." .

rl2:Violated a rl2:ObligationState ;
    rdfs:label "Violated" ;
    rdfs:comment "The Duty's violation condition holds, or a Promise's promised state or action has been breached." .

############################################################
# 5. Policy Containers
############################################################

rl2:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment """A container of one or more RL2 normative clauses.
    A policy may optionally have an activation condition (rl2:condition).
    When present, the policy is only applicable when its condition holds.
    A later evaluation may supply a different WorldSnapshot and obtain different
    applicability; Eval does not mutate policy state.""" .

# Policy Types as Subclasses
rl2:Set a owl:Class ;
    rdfs:subClassOf rl2:Policy ;
    rdfs:label "Set" ;
    rdfs:comment """An operative policy without the Agreement requirement to identify one
    grantor and one grantee. It may represent a public license, general terms, or a policy
    template.""" .

rl2:Offer a owl:Class ;
    rdfs:subClassOf rl2:Policy ;
    rdfs:label "Offer" ;
    rdfs:comment """Proposed policy terms that are not operative before acceptance.
    Its Promises do not create Agreement Duties until pure materialization produces an
    Agreement.""" .

rl2:Agreement a owl:Class ;
    rdfs:subClassOf rl2:Policy ;
    rdfs:label "Agreement" ;
    rdfs:comment """An operative policy that identifies one grantor and one grantee.
    RL2 evaluates its terms but does not determine legal formation, consent, or enforceability.""" .

[] a owl:AllDisjointClasses ;
    owl:members (rl2:Set rl2:Offer rl2:Agreement) .

rl2:clause a owl:ObjectProperty ;
    rdfs:domain rl2:Policy ;
    rdfs:range rl2:Clause ;
    rdfs:comment """Associates a Clause (a Norm, or a Promise) with a policy container.
    A Duty linked directly with rl2:clause is an independent obligation. A Duty used as a
    Privilege prerequisite is linked only with rl2:prerequisiteDuty; its policy provenance is
    derived through that owning Privilege.
    A Promise is a legitimate clause only in an Offer and crystallizes on acceptance into a
    Duty. A well-formed Agreement or Set contains only Norms.""" .

############################################################
# 6. Profile Declaration
############################################################

rl2:Profile a owl:Class ;
    rdfs:label "Profile" ;
    rdfs:comment """A named, versioned extension of RL2 Core that declares domain-specific
    operands, actions, and classes (see profiles/). A Profile individual carries an IRI
    (its identity) and an rl2:profileVersion. Policies depend on profiles via
    rl2:requiresProfile.""" .

rl2:profileVersion a owl:DatatypeProperty ;
    rdfs:domain rl2:Profile ;
    rdfs:range xsd:string ;
    rdfs:label "Profile Version" ;
    rdfs:comment """The version of a Profile, as a SemVer string ('MAJOR.MINOR.PATCH').
    When a policy requires a profile, the referenced Profile individual's version is the
    MINIMUM version the evaluator must support. Negotiation rule: an evaluator supporting
    (profileIRI, supportedVersion) satisfies a requirement for (profileIRI, requiredVersion)
    iff supportedVersion.MAJOR = requiredVersion.MAJOR and supportedVersion >= requiredVersion
    (same-major, at-least-minor). See RL2_Semantics.md §Profile Resolution.""" .

rl2:requiresProfile a owl:ObjectProperty ;
    rdfs:domain rl2:Policy ;
    rdfs:range rl2:Profile ;
    rdfs:label "Requires Profile" ;
    rdfs:comment """Declares that a Policy depends on a profile's vocabulary. A conforming
    evaluator MUST reject a Policy that
    rl2:requiresProfile a profile it does not support, or supports only at an incompatible
    version (see rl2:profileVersion negotiation). Rejection is at ingestion, before
    evaluation — an unsupported required profile is a load-time error, never a silently
    ignored annotation. This keeps a policy from evaluating with a partially-understood
    vocabulary.""" .
